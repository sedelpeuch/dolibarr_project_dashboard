################################################################################
# Balthazar - Project Dashboard Configuration
# Copy this file to .env and fill in your values
################################################################################

# ============================================================================
# DOLIBARR API CONFIGURATION (REQUIRED)
# ============================================================================
export DOLIBARR_URL=https://your-dolibarr-instance.com
export DOLIAPIKEY=your_api_key_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Name of the application (displayed in header)
export APP_NAME=Balthazar

# Current user ID for API calls
export CURRENT_USER_ID=42

# ============================================================================
# FASTAPI BACKEND CONFIGURATION
# ============================================================================
export FASTAPI_HOST=0.0.0.0
export FASTAPI_PORT=8000
export FASTAPI_ENV=development

# CORS origins (comma-separated)
export CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================
# Backend API URL
export VITE_API_BASE_URL=http://localhost:8000/api

# Application name (mirrored from APP_NAME)
export VITE_APP_NAME=Balthazar

# Enable/disable meta-projects feature
export VITE_ENABLE_META_PROJECTS=true
